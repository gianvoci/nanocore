{
    "name": "gianvoci/nanocore",
    "description": "Lightweight PHP micro-framework with routing, config management, a micro ORM, and utility functions. Zero dependencies.",
    "type": "library",
    "license": "GPL-3.0-or-later",
    "keywords": ["framework", "micro-framework", "routing", "orm", "config", "lightweight", "php"],
    "homepage": "https://github.com/gianvoci/nanocore",
    "support": {
        "issues": "https://github.com/gianvoci/nanocore/issues",
        "source": "https://github.com/gianvoci/nanocore",
        "docs": "https://github.com/gianvoci/nanocore/tree/main/docs"
    },
    "autoload": {
        "psr-4": {
            "NanoCore\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Giancarlo Voci",
            "email": "softword@gvoci.com"
        }
    ],
    "require": {
        "php": ">=8.5"
    },
    "archive": {
        "exclude": ["/docs", "/tests", "nanocore.log", "app.json", "CLAUDE.md", ".gitignore"]
    }
}
